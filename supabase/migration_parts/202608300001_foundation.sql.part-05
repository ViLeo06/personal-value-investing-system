decision_events(backtest_run_id, decision_at, security_id);

create table backtest.transactions (
    transaction_id bigint generated always as identity primary key,
    backtest_run_id uuid not null references backtest.backtest_runs(backtest_run_id) on delete cascade,
    decision_id uuid references backtest.decision_events(decision_id),
    security_id uuid not null references master.securities(security_id),
    trade_date date not null,
    side text not null check (side in ('buy', 'sell')),
    quantity numeric not null,
    price numeric not null,
    fees numeric not null default 0,
    slippage numeric not null default 0,
    currency text not null
);

create table backtest.position_snapshots (
    backtest_run_id uuid not null references backtest.backtest_runs(backtest_run_id) on delete cascade,
    trade_date date not null,
    security_id uuid not null references master.securities(security_id),
    quantity numeric not null,
    market_value numeric not null,
    weight numeric,
    currency text not null,
    primary key (backtest_run_id, trade_date, security_id)
);

create table backtest.daily_performance (
    backtest_run_id uuid not null references backtest.backtest_runs(backtest_run_id) on delete cascade,
    trade_date date not null,
    nav numeric not null,
    daily_return numeric,
    benchmark_return numeric,
    cash_value numeric,
    gross_exposure numeric,
    drawdown numeric,
    primary key (backtest_run_id, trade_date)
);

create table audit.run_lineage (
    lineage_id bigint generated always as identity primary key,
    run_type text not null,
    run_id uuid not null,
    input_type text not null,
    input_id text,
    input_hash text,
    metadata jsonb not null default '{}'::jsonb,
    recorded_at timestamptz not null default now()
);

create index run_lineage_run_idx on audit.run_lineage(run_type, run_id);

-- Defense-in-depth: no direct client roles on internal tables.
revoke all privileges on all tables in schema master, raw, pit, fundamentals, model, backtest, audit from anon, authenticated;
revoke all privileges on all sequences in schema master, raw, pit, fundamentals, model, backtest, audit from anon, authenticated;

-- Prevent future tables in these schemas from accidentally granting client access.
alter default privileges for role postgres in schema master revoke all on tables from anon, authenticated;
alter default privileges for role postgres in schema raw revoke all on tables from anon, authenticated;
alter default privileges for role postgres in schema pit revoke all on tables from anon, authenticated;
alter default privileges for role postgres in schema fundamentals revoke all on tables from anon, authenticated;
alter default privileges for role postgres in schema model revoke all on tables from anon, authenticated;
alter default privileges for role postgres in schema backtest revoke all on tables from anon, authenticated;
alter default privileges for role postgres in schema audit revoke all on tables from anon, authenticated;

commit;
